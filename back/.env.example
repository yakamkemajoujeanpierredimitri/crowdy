# Copy to .env for local development. On Render, set these under the service's "Environment".

# Render sets PORT automatically; 5000 is the local default
PORT=5000

# PostgreSQL 13+ with PostGIS (the app runs CREATE EXTENSION postgis on startup)
# On Render use the database's *Internal* Database URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crowdsense

# Optional - without it the app uses an in-memory cache
REDIS_URL=redis://localhost:6379

# Optional - live busyness from besttime.app
BESTTIME_API_KEY=
BESTTIME_API_KEY_PUBLIC=

# Optional - timezone used for "current hour" of the crowd curves
APP_TIMEZONE=Europe/Paris

# Optional - OpenStreetMap asks for an identifying User-Agent with contact info
NOMINATIM_USER_AGENT=CrowdSense/1.0 (you@example.com)
